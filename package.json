{
  "name": "tnx-cast-list-production",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:troop": "node --test tests/troop-*.test.mjs",
    "test:visual": "playwright test --config=playwright.visual.config.js",
    "test:visual:production": "playwright test --config=playwright.visual.config.js --project=visual-desktop --grep-invert '\u30ad\u30e3\u30b9\u30c8\u95b2\u89a7 spectrum-neon' && playwright test --config=playwright.visual.config.js --project=visual-mobile",
    "test:quality": "playwright test --config=playwright.quality.config.js",
    "check:js": "node scripts/check-js.mjs",
    "audit:cache": "node scripts/audit-editor-cache-policy.mjs",
    "audit:modules": "node scripts/audit-module-graph.mjs",
    "audit:integrity": "node scripts/audit-runtime-integrity.mjs",
    "audit:css": "node scripts/audit-css-rebuild.mjs",
    "audit:showcase": "node scripts/audit-act-showcase-architecture.mjs",
    "audit:themes": "node scripts/audit-theme-system.mjs",
    "audit:sheet": "node scripts/audit-sheet-runtime.mjs",
    "audit:cast": "node scripts/audit-cast-runtime.mjs",
    "audit:troop": "node scripts/audit-troop-runtime.mjs",
    "audit:mobile": "node scripts/audit-mobile-editor-runtime.mjs",
    "audit:security": "node scripts/audit-security.mjs",
    "audit:migrations": "node scripts/audit-migrations.mjs",
    "audit:quality": "node scripts/audit-quality-gates.mjs",
    "audit:js-reachability": "node scripts/audit-js-reachability.mjs",
    "audit:e2e": "node scripts/audit-e2e-suite.mjs",
    "audit:ci": "node scripts/audit-ci-contract.mjs",
    "report:sheet-ownership": "node scripts/report-sheet-dom-ownership.mjs",
    "report:cast-ownership": "node scripts/report-cast-dom-ownership.mjs",
    "verify": "npm run check:js && npm run audit:cache && npm run audit:modules && npm run audit:integrity && npm run audit:css && npm run audit:showcase && npm run audit:themes && npm run audit:sheet && npm run audit:cast && npm run audit:troop && npm run audit:mobile && npm run audit:security && npm run audit:migrations && npm run audit:quality && npm run audit:js-reachability && npm run audit:e2e && npm run audit:ci && npm run report:sheet-ownership && npm run report:cast-ownership && npm test",
    "e2e": "playwright test",
    "e2e:ci-public": "node scripts/run-e2e-suite.mjs ci-public",
    "e2e:ci-editor": "node scripts/run-e2e-suite.mjs ci-editor",
    "e2e:ci-mobile": "node scripts/run-e2e-suite.mjs ci-mobile",
    "e2e:live-write": "node scripts/run-e2e-suite.mjs live-write",
    "e2e:manual-ui": "node scripts/run-e2e-suite.mjs manual-ui",
    "e2e:troop": "playwright test tests/e2e/troop-view.spec.js tests/e2e/troop-editor-flow.spec.js --project=chromium",
    "e2e:headed": "playwright test --headed",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install chromium webkit",
    "check:db:live": "node scripts/audit-live-db.mjs"
  },
  "devDependencies": {
    "@fontsource/noto-sans-jp": "5.3.0",
    "@playwright/test": "1.62.1"
  }
}
